# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/

# ── Model checkpoints & large binaries (release via HF/Zenodo, not git) ───
models/checkpoints/*.pt
*.pt
*.ckpt
*.safetensors

# ── Data: raw genomes and derived caches are NOT versioned ───────────────
data/raw/*.npy
data/raw/*.fa
data/raw/*.fa.gz
data/raw/*.fna
data/raw/*.fna.gz
data/preference_pairs/*.csv
*.pkl
*.pkl.zip

# ── Generated results (regenerated by the pipeline) ──────────────────────
results/plots/*.png
results/plots/*.pdf
results/*.log
results/**/*.tmp

# Keep JSON/CSV metric summaries under version control (they are small,
# and reviewers want the exact reported numbers):
!results/json/*.json
!results/csv/*.csv

# ── OS / editor cruft ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
